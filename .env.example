# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set this to require a Basic Auth password to access the site.
# Leave unset to disable access restriction.
SITE_PASSWORD=your_site_password_here

# Instagram long-lived access token (60 days). Used at runtime to fetch real
# captions as few-shot examples, and kept alive by the daily cron job.
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

# Resend API key (https://resend.com) — used by the token-refresh cron to send
# alert emails when the Instagram token needs manual action. Optional.
RESEND_API_KEY=your_resend_api_key_here

# Where token alert emails go. Defaults to guystyle@gmail.com if unset.
ALERT_EMAIL=guystyle@gmail.com

# Optional: shared secret so only Vercel Cron can call /api/cron/* endpoints.
# Set the same value in Vercel; Vercel Cron sends it automatically.
CRON_SECRET=any_random_string
