# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set this to require a Basic Auth password to access the site.
# Leave unset to disable access restriction.
SITE_PASSWORD=your_site_password_here

# Instagram long-lived access token (60 days) — only needed to run
# scripts/fetch-captions.mjs, which collects real captions as few-shot examples.
# Refresh with: node --env-file=.env.local scripts/fetch-captions.mjs --refresh
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
